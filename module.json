{
  "id": "fast-fighting",
  "title": "FastFighting Core",
  "description": "Estimate, narrate and resolve battles from the encounter on the scene: Monte Carlo simulation with personalities, tactics, talking, terrain and bystanders, a story of the fight, and Do it For Real Now to play it on the Combat Tracker, a turn at a time. System support comes from helper modules such as FastFighting PF2e; a generic adapter covers the rest.",
  "version": "0.2.6",
  "authors": [
    {
      "name": "galaara98",
      "url": "https://github.com/galaara98"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/fast-fighting.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "languages",
        "story"
      ]
    }
  },
  "url": "https://github.com/galaara98/FastFighting",
  "manifest": "https://github.com/galaara98/FastFighting/releases/latest/download/module.json",
  "download": "https://github.com/galaara98/FastFighting/releases/download/v0.2.6/module.zip",
  "bugs": "https://github.com/galaara98/FastFighting/issues",
  "readme": "https://github.com/galaara98/FastFighting/blob/main/README.md",
  "license": "LICENSE"
}
