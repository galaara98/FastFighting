{
  "id": "fast-fighting",
  "title": "FastFighting Core",
  "description": "Simulates the scene's encounter to estimate the odds, tells the fight as a story, and plays it on the Combat Tracker turn by turn. Helper modules such as FastFighting PF2e add each game system.",
  "version": "0.5.0",
  "authors": [
    {
      "name": "galaara98",
      "url": "https://github.com/galaara98"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/fast-fighting.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "languages",
        "story"
      ]
    }
  },
  "url": "https://github.com/galaara98/FastFighting",
  "manifest": "https://github.com/galaara98/FastFighting/releases/latest/download/module.json",
  "download": "https://github.com/galaara98/FastFighting/releases/download/v0.5.0/module.zip",
  "bugs": "https://github.com/galaara98/FastFighting/issues",
  "readme": "https://github.com/galaara98/FastFighting/blob/main/README.md",
  "license": "LICENSE"
}
