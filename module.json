{
  "id": "fast-fighting",
  "title": "FastFighting",
  "description": "Estimate the outcome of a battle from the tokens on the scene. Monte Carlo simulation with GM-tunable tactics, morale, leadership, terrain and healing. System agnostic, with built-in Pathfinder 2e support and an API for helper modules.",
  "version": "0.1.0",
  "authors": [
    { "name": "galaara98", "url": "https://github.com/galaara98" }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": ["scripts/main.js"],
  "styles": ["styles/fast-fighting.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "languages/en.json" }
  ],
  "socket": true,
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "languages"]
    }
  },
  "url": "https://github.com/galaara98/FastFighting",
  "manifest": "https://github.com/galaara98/FastFighting/releases/latest/download/module.json",
