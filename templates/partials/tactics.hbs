<div class="ff-playstyles">
  <div class="ff-q-label">{{localize "FASTFIGHTING.Playstyle.Label"}} <span class="ff-pill-count">{{playstyleCount}}</span>
    <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Playstyle.Hint"}}"></i></div>
  <div class="ff-pills" data-actor-uuid="{{actorUuid}}">
    {{#each playstyles}}<button type="button" class="ff-pill {{#if active}}active{{/if}}" data-action="togglePlaystyle" data-playstyle="{{id}}" data-actor-uuid="{{../actorUuid}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#if disabled}}disabled{{/if}} data-tooltip="{{hint}}"><i class="fa-solid {{icon}}"></i> {{label}}<span class="ff-pill-order">{{#if active}}{{order}}{{/if}}</span></button>{{/each}}
  </div>
  <div class="ff-pill-flags">
    <label class="ff-check"><input type="checkbox" name="{{stayTrue.name}}" data-tactic="stayTrue" data-actor-uuid="{{actorUuid}}" {{checked stayTrue.checked}}> {{localize "FASTFIGHTING.Playstyle.StayTrue"}}
      <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Playstyle.StayTrueHint"}}"></i></label>
    <label class="ff-check"><input type="checkbox" name="{{roleplay.name}}" data-tactic="roleplay" data-actor-uuid="{{actorUuid}}" {{checked roleplay.checked}}> {{localize "FASTFIGHTING.Playstyle.Roleplay"}}
      <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Playstyle.RoleplayHint"}}"></i></label>
    {{#if avoidConsumables.show}}
    <label class="ff-check"><input type="checkbox" name="{{avoidConsumables.name}}" data-tactic="avoidConsumables" data-actor-uuid="{{actorUuid}}" {{checked avoidConsumables.checked}}> {{localize "FASTFIGHTING.Playstyle.AvoidConsumables"}}
      <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Playstyle.AvoidConsumablesHint"}}"></i></label>
    {{/if}}
    {{#if avoidCostlySpells.show}}
    <label class="ff-check"><input type="checkbox" name="{{avoidCostlySpells.name}}" data-tactic="avoidCostlySpells" data-actor-uuid="{{actorUuid}}" {{checked avoidCostlySpells.checked}}> {{localize "FASTFIGHTING.Playstyle.AvoidCostlySpells"}}
      <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Playstyle.AvoidCostlySpellsHint"}}"></i></label>
    {{/if}}
  </div>
  {{#if conflict}}<p class="ff-hint"><i class="fa-solid fa-circle-info"></i> {{localize "FASTFIGHTING.Playstyle.Both"}}</p>{{/if}}
</div>
{{#if desires}}
<div class="ff-desires">
  <div class="ff-q-label">{{localize "FASTFIGHTING.Desire.Label"}} <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Desire.Hint"}}"></i></div>
  {{#each desires}}
  <div class="ff-desire {{#if empty}}is-empty{{/if}}">
    <select name="{{kind.name}}" data-tactic="{{kind.key}}" data-actor-uuid="{{../actorUuid}}" aria-label="{{localize "FASTFIGHTING.Desire.What"}}">{{#each kind.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    <select name="{{target.name}}" data-tactic="{{target.key}}" data-actor-uuid="{{../actorUuid}}" aria-label="{{localize "FASTFIGHTING.Desire.Who"}}">{{#each target.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    <select name="{{level.name}}" data-tactic="{{level.key}}" data-actor-uuid="{{../actorUuid}}" aria-label="{{localize "FASTFIGHTING.Desire.HowMuch"}}">{{#each level.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
  </div>
  {{/each}}
</div>
{{/if}}
{{#if withQuestions}}
<div class="ff-tactics">
  {{#each questions}}
  <div class="ff-q {{#if isAuto}}is-auto{{/if}}">
    <label class="ff-q-label" for="{{name}}">{{label}} <i class="fa-solid fa-circle-question" data-tooltip="{{hint}}"></i></label>
    <select id="{{name}}" name="{{name}}" data-tactic="{{key}}" data-actor-uuid="{{../actorUuid}}">
      {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </div>
  {{/each}}
</div>
{{/if}}
{{#if motives}}
<div class="ff-motives">
  {{#each motives.sides}}
  <div class="ff-motive" data-motive="{{which}}">
    <div class="ff-q-label">{{label}} <i class="fa-solid fa-circle-question" data-tooltip="{{hint}}"></i></div>
    <div class="ff-pills ff-motive-kinds">
      {{#each kinds}}<button type="button" class="ff-pill {{#if active}}active{{/if}}" data-action="setMotive" data-motive="{{../which}}" data-kind="{{value}}" data-actor-uuid="{{../actorUuid}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
    </div>
    {{#if money}}
    <div class="ff-motive-fields">
      <input type="number" min="0" step="1" name="{{money.amount.name}}" value="{{money.amount.value}}" data-tactic="{{money.amount.key}}" data-actor-uuid="{{actorUuid}}" aria-label="{{localize "FASTFIGHTING.Motive.Amount"}}">
      {{#if money.coin}}<select name="{{money.coin.name}}" data-tactic="{{money.coin.key}}" data-actor-uuid="{{actorUuid}}" aria-label="{{localize "FASTFIGHTING.Motive.Coin"}}">{{#each money.coin.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<span class="ff-motive-unit">{{money.unit}}</span>{{/if}}
      {{#if money.have}}<span class="ff-hint">{{money.have}}</span>{{/if}}
    </div>
    {{/if}}
    {{#if item}}
    <div class="ff-motive-fields">
      <select name="{{item.name}}" data-tactic="{{item.key}}" data-actor-uuid="{{actorUuid}}" aria-label="{{localize "FASTFIGHTING.Motive.Item"}}">{{#each item.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </div>
    {{/if}}
    {{#if thing}}
    <div class="ff-motive-fields">
      {{#if thing.category}}<select name="{{thing.names.category}}" data-tactic="{{thing.keys.category}}" data-actor-uuid="{{actorUuid}}" aria-label="{{localize "FASTFIGHTING.Motive.Category"}}">{{#each thing.category}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
      {{#if thing.material}}<select name="{{thing.names.material}}" data-tactic="{{thing.keys.material}}" data-actor-uuid="{{actorUuid}}" aria-label="{{localize "FASTFIGHTING.Motive.Material"}}">{{#each thing.material}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
      {{#if thing.rarity}}<select name="{{thing.names.rarity}}" data-tactic="{{thing.keys.rarity}}" data-actor-uuid="{{actorUuid}}" aria-label="{{localize "FASTFIGHTING.Motive.Rarity"}}">{{#each thing.rarity}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
    </div>
    <div class="ff-motive-fields">
      {{#if thing.coin}}
      <label class="ff-motive-worth">{{localize "FASTFIGHTING.Motive.MinValue"}}
        <input type="number" min="0" step="1" name="{{thing.names.minValue}}" value="{{thing.minValue}}" data-tactic="{{thing.keys.minValue}}" data-actor-uuid="{{actorUuid}}"></label>
      <select name="{{thing.names.coin}}" data-tactic="{{thing.keys.coin}}" data-actor-uuid="{{actorUuid}}" aria-label="{{localize "FASTFIGHTING.Motive.Coin"}}">{{#each thing.coin}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      {{else if thing.unit}}
      <label class="ff-motive-worth">{{localize "FASTFIGHTING.Motive.MinValue"}}
        <input type="number" min="0" step="1" name="{{thing.names.minValue}}" value="{{thing.minValue}}" data-tactic="{{thing.keys.minValue}}" data-actor-uuid="{{actorUuid}}"></label>
      <span class="ff-motive-unit">{{thing.unit}}</span>
      {{/if}}
      <label class="ff-check"><input type="checkbox" name="{{thing.names.unvalued}}" data-tactic="{{thing.keys.unvalued}}" data-actor-uuid="{{actorUuid}}" {{checked thing.unvalued}}> {{localize "FASTFIGHTING.Motive.Unvalued"}}
        <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Motive.UnvaluedHint"}}"></i></label>
    </div>
    {{/if}}
  </div>
  {{/each}}
</div>
{{/if}}
