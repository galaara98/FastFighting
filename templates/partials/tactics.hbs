<div class="ff-playstyles">
  <div class="ff-q-label">{{localize "FASTFIGHTING.Playstyle.Label"}} <span class="ff-pill-count">{{playstyleCount}}</span>
    <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Playstyle.Hint"}}"></i></div>
  <div class="ff-pills" data-actor-uuid="{{actorUuid}}">
    {{#each playstyles}}<button type="button" class="ff-pill {{#if active}}active{{/if}}" data-action="togglePlaystyle" data-playstyle="{{id}}" data-actor-uuid="{{../actorUuid}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#if disabled}}disabled{{/if}} data-tooltip="{{hint}}"><i class="fa-solid {{icon}}"></i> {{label}}<span class="ff-pill-order">{{#if active}}{{order}}{{/if}}</span></button>{{/each}}
  </div>
  {{#if playstyleEffects}}<div class="ff-auto-value ff-pill-effects" data-tooltip="{{localize "FASTFIGHTING.Playstyle.EffectsHint"}}"><i class="fa-solid fa-eye"></i> {{playstyleEffects}}</div>{{/if}}
  <div class="ff-pill-flags">
    <label class="ff-check"><input type="checkbox" name="{{stayTrue.name}}" data-tactic="stayTrue" data-actor-uuid="{{actorUuid}}" {{checked stayTrue.checked}}> {{localize "FASTFIGHTING.Playstyle.StayTrue"}}
      <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Playstyle.StayTrueHint"}}"></i></label>
    <label class="ff-check"><input type="checkbox" name="{{roleplay.name}}" data-tactic="roleplay" data-actor-uuid="{{actorUuid}}" {{checked roleplay.checked}}> {{localize "FASTFIGHTING.Playstyle.Roleplay"}}
      <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Playstyle.RoleplayHint"}}"></i></label>
    {{#if avoidCostlySpells.show}}
    <label class="ff-check"><input type="checkbox" name="{{avoidCostlySpells.name}}" data-tactic="avoidCostlySpells" data-actor-uuid="{{actorUuid}}" {{checked avoidCostlySpells.checked}}> {{localize "FASTFIGHTING.Playstyle.AvoidCostlySpells"}}
      <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Playstyle.AvoidCostlySpellsHint"}}"></i></label>
    {{/if}}
  </div>
  {{#if conflict}}<p class="ff-hint"><i class="fa-solid fa-circle-info"></i> {{localize "FASTFIGHTING.Playstyle.Both"}}</p>{{/if}}
</div>
{{#if desires}}
<div class="ff-desires">
  <div class="ff-q-label">{{localize "FASTFIGHTING.Desire.Label"}} <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Desire.Hint"}}"></i></div>
  {{#each desires}}
  <div class="ff-desire {{#if empty}}is-empty{{/if}}">
    <select name="{{kind.name}}" data-tactic="{{kind.key}}" data-actor-uuid="{{../actorUuid}}" aria-label="{{localize "FASTFIGHTING.Desire.What"}}">{{#each kind.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    <select name="{{target.name}}" data-tactic="{{target.key}}" data-actor-uuid="{{../actorUuid}}" aria-label="{{localize "FASTFIGHTING.Desire.Who"}}">{{#each target.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    <select name="{{level.name}}" data-tactic="{{level.key}}" data-actor-uuid="{{../actorUuid}}" aria-label="{{localize "FASTFIGHTING.Desire.HowMuch"}}">{{#each level.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
  </div>
  {{/each}}
</div>
{{/if}}
{{#if reactions}}
<div class="ff-reactions">
  <div class="ff-q-label">{{localize "FASTFIGHTING.Tactics.Reactions.Label"}} <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Tactics.Reactions.Hint"}}"></i></div>
  {{#each reactions}}
  <label class="ff-reaction">{{label}}
    <select name="{{name}}" data-tactic="{{key}}" data-actor-uuid="{{../actorUuid}}">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
  </label>
  {{/each}}
</div>
{{/if}}
{{#if rerolls}}
<div class="ff-rerolls">
  <div class="ff-q-label">{{localize "FASTFIGHTING.Tactics.Rerolls.Label" resource=rerolls.resource}} <i class="fa-solid fa-circle-question" data-tooltip="{{localize "FASTFIGHTING.Tactics.Rerolls.Hint"}}"></i></div>
  <label class="ff-check"><input type="checkbox" name="{{rerolls.self.name}}" data-tactic="{{rerolls.self.key}}" data-actor-uuid="{{actorUuid}}" {{checked rerolls.self.checked}}> {{localize "FASTFIGHTING.Tactics.Rerolls.Self"}}</label>
  <label class="ff-check"><input type="checkbox" name="{{rerolls.team.name}}" data-tactic="{{rerolls.team.key}}" data-actor-uuid="{{actorUuid}}" {{checked rerolls.team.checked}}> {{localize "FASTFIGHTING.Tactics.Rerolls.Team"}}</label>
</div>
{{/if}}
{{#if hidden}}
<div class="ff-hidden-scores">
  <div class="ff-q-label">{{localize "FASTFIGHTING.TokenTactics.Hidden"}} <i class="fa-solid fa-eye" data-tooltip="{{localize "FASTFIGHTING.TokenTactics.HiddenHint"}}"></i></div>
  <div class="ff-hidden-row">
    {{#each hidden}}<span class="ff-hidden-score" data-tooltip-text="{{reason}}"><span class="ff-hidden-label">{{label}}</span> <strong>{{value}}</strong> <span class="ff-hidden-band">{{band}}</span></span>{{/each}}
  </div>
</div>
{{/if}}
{{#if withQuestions}}
<div class="ff-tactics">
  {{#each questions}}
  <div class="ff-q {{#if isAuto}}is-auto{{/if}}">
    <label class="ff-q-label" for="{{name}}">{{label}} <i class="fa-solid fa-circle-question" data-tooltip="{{hint}}"></i></label>
    <select id="{{name}}" name="{{name}}" data-tactic="{{key}}" data-actor-uuid="{{../actorUuid}}">
      {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
    {{#if autoValue}}<div class="ff-auto-value" data-tooltip="{{localize "FASTFIGHTING.Tactics.AutoHint"}}"><i class="fa-solid fa-eye"></i> {{autoValue}}</div>{{/if}}
  </div>
  {{/each}}
</div>
{{/if}}
