<div class="ff-party">
  <p class="ff-hint">{{localize "FASTFIGHTING.Party.Intro"}}</p>
  {{#each questions}}
  <div class="ff-party-q">
    <div class="ff-q-label">{{label}} <i class="fa-solid fa-circle-question" data-tooltip="{{hint}}"></i></div>
    <div class="ff-pills">
      {{#each options}}
      <button type="button" class="ff-pill {{#if mine}}active{{/if}} {{#if winning}}is-winning{{/if}}" data-action="partyVote" data-question="{{../key}}" data-answer="{{value}}" aria-pressed="{{#if mine}}true{{else}}false{{/if}}" {{#unless @root.party.canVote}}disabled{{/unless}}>
        {{label}}{{#each voters}}<span class="ff-voter" style="background: {{color}}" data-tooltip-text="{{name}}">{{initial}}</span>{{/each}}
      </button>
      {{/each}}
    </div>
  </div>
  {{/each}}
  {{#if canVote}}
  <div class="ff-lockin">
    <input type="range" class="ff-swipe" data-swipe="lockIn" min="0" max="100" value="0" aria-label="{{localize "FASTFIGHTING.Party.LockIn"}}">
    <span class="ff-swipe-label" aria-hidden="true">{{localize "FASTFIGHTING.Party.LockIn"}} <i class="fa-solid fa-angles-right"></i></span>
  </div>
  {{else if locked}}
  <p class="ff-locked"><i class="fa-solid fa-lock"></i> {{localize "FASTFIGHTING.Party.LockedIn"}}</p>
  {{else if readOnly}}
  <p class="ff-hint"><i class="fa-solid fa-eye"></i> {{localize "FASTFIGHTING.Party.ReadOnly"}}</p>
  {{else}}
  <p class="ff-hint"><i class="fa-solid fa-eye"></i> {{localize "FASTFIGHTING.Party.GmView"}}</p>
  {{/if}}
</div>
