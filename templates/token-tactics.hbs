<div class="ff-token-tactics-head">
  <p class="hint">{{hint}}</p>
  <button type="button" class="ff-btn" data-action="resetAll" data-tooltip="{{localize "FASTFIGHTING.Survey.ResetHint"}}"><i class="fa-solid fa-rotate-left"></i> {{localize "FASTFIGHTING.Survey.Reset"}}</button>
</div>
{{#if tactics}}
{{> "modules/fast-fighting/templates/partials/tactics.hbs" tactics}}
{{else}}
<p class="ff-hint">{{localize "FASTFIGHTING.TokenTactics.HazardNoTactics"}}</p>
{{/if}}
{{#unless isHazard}}
<div class="ff-token-adhd">
  <label class="ff-q-label">{{localize "FASTFIGHTING.Trait.adhd"}} <span data-ff-adhd-value>{{adhd}}%</span>
    <input type="range" min="0" max="100" step="10" value="{{adhd}}" data-ff-setting="adhd">
  </label>
  <p class="ff-hint">{{localize "FASTFIGHTING.TraitTip.adhd"}}</p>
</div>
{{/unless}}
{{#if markable}}
<div class="ff-token-hazard">
  <label class="ff-q-label">{{localize "FASTFIGHTING.TokenTactics.Hazard"}}
    <select data-ff-setting="hazard">{{selectOptions hazardChoices selected=hazard}}</select>
  </label>
  <p class="ff-hint">{{localize "FASTFIGHTING.TokenTactics.HazardHint"}}</p>
</div>
<div class="ff-token-secret">
  <label class="ff-check" data-tooltip="{{localize "FASTFIGHTING.TokenTactics.SecretNameHint"}}"><input type="checkbox" data-ff-setting="secretName" {{checked secretName}}> {{localize "FASTFIGHTING.TokenTactics.SecretName"}}</label>
</div>
{{/if}}
