<section class="ff-battle-body">
  {{#if none}}
    <p class="ff-battle-none">{{localize "FASTFIGHTING.Battle.None"}}</p>
  {{else}}
    {{#if review}}
    <section class="ff-battle-review">
      <p><strong>{{review.title}}</strong></p>
      <ul>
        {{#each review.events}}
        <li data-event="{{i}}" class="{{#if unsure}}is-unsure{{/if}}">
          <label><input type="checkbox" name="keep" checked> {{text}}</label>
          {{#if pick}}
          <select name="target">{{#each targets}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          {{/if}}
          {{#if talk}}
          <select name="target">{{#each targets}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select name="kind">{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select name="degree">{{#each degrees}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          {{/if}}
        </li>
        {{/each}}
      </ul>
      <button type="button" class="ff-btn" data-action="tellIt"><i class="fa-solid fa-feather"></i> {{localize "FASTFIGHTING.Battle.TellIt"}}</button>
    </section>
    {{/if}}
    <header class="ff-battle-turn">
      <div class="ff-battle-now">
        <span class="ff-chip">{{localize "FASTFIGHTING.Battle.Round" n=round}}</span>
        <strong>{{turn}}</strong>
        <span class="ff-battle-state {{state}}">{{stateText}}</span>
      </div>
      <div class="ff-battle-buttons">
        {{#if canContinue}}<button type="button" class="ff-btn" data-action="continue"><i class="fa-solid fa-forward"></i> {{localize "FASTFIGHTING.Live.Continue"}}</button>{{/if}}
        {{#if spotlight}}<button type="button" class="ff-btn" data-action="spotlight" data-tooltip="{{localize "FASTFIGHTING.Battle.SpotlightHint"}}"><i class="fa-solid fa-lightbulb"></i> {{spotlight}}</button>{{/if}}
        {{#if canSettle}}<button type="button" class="ff-btn" data-action="aftermath" data-tooltip="{{localize "FASTFIGHTING.Live.AftermathHint"}}"><i class="fa-solid fa-hand-holding-medical"></i> {{localize "FASTFIGHTING.Live.Aftermath"}}</button>{{/if}}
        {{#if canPlay}}<button type="button" class="ff-btn" data-action="play"><i class="fa-solid fa-play"></i> {{localize "FASTFIGHTING.Live.Play"}}</button>{{/if}}
        <button type="button" class="ff-btn" data-action="rewind" {{#unless canRewind}}disabled{{/unless}}><i class="fa-solid fa-backward-step"></i> {{localize "FASTFIGHTING.Live.RewindTurn"}}</button>
        <button type="button" class="ff-btn" data-action="rewindAll"><i class="fa-solid fa-backward"></i> {{localize "FASTFIGHTING.MakeItSo.Undo"}}</button>
      </div>
      <div class="ff-toggles">
        <label data-tooltip="{{localize "FASTFIGHTING.Battle.PlayThroughHint"}}"><input type="checkbox" data-action="playThrough" {{checked playThrough}}> {{localize "FASTFIGHTING.Battle.PlayThrough"}}</label>
        <label data-tooltip="{{localize "FASTFIGHTING.Battle.NpcAskHint"}}"><input type="checkbox" data-action="npcReactions" {{checked npcAsk}}> {{localize "FASTFIGHTING.Battle.NpcAsk"}}</label>
      </div>
      {{#if held.length}}
        <div class="ff-battle-held">
          <p class="hint">{{localize "FASTFIGHTING.Battle.Held"}}</p>
          <ul>{{#each held}}<li>{{text}} <a data-action="dropHeld" data-index="{{i}}" data-tooltip="{{localize "FASTFIGHTING.Battle.Drop"}}"><i class="fa-solid fa-xmark"></i></a></li>{{/each}}</ul>
        </div>
      {{/if}}
    </header>

    <div class="ff-battle-main">
      <div class="ff-net" tabindex="-1" aria-label="{{localize "FASTFIGHTING.Battle.Net.Label"}}"></div>

      <aside class="ff-battle-side">
        {{#if focus.none}}
          <p class="hint">{{localize "FASTFIGHTING.Battle.Net.FocusHint"}}</p>
        {{/if}}

        {{#if focus.elsewhere}}
          <div class="ff-battle-who"><img src="{{focus.img}}" alt=""><div><h3>{{focus.name}}</h3><span class="ff-battle-meta">{{localize "FASTFIGHTING.Battle.Net.NotInBattle"}}</span></div></div>
          <button type="button" class="ff-btn" data-action="bringIn" data-token="{{focus.tokenId}}"><i class="fa-solid fa-right-to-bracket"></i> {{localize "FASTFIGHTING.Battle.BringIn"}}</button>
        {{/if}}

        {{#if focus.thing}}
          <h3><i class="{{focus.icon}}"></i> {{focus.name}}</h3>
          <section>
            <p>{{localize "FASTFIGHTING.Battle.Net.WantedBy"}}</p>
            <ul class="ff-battle-list">
              {{#each focus.rows}}
              <li class="{{cls}}"><i class="{{icon}}"></i> <span>{{text}}</span>
                {{#if steps.length}}<span class="ff-net-steps">{{#each steps}}<a class="ff-net-step" data-action="adjust" data-adjust="{{adjust}}" data-step="{{dir}}" data-tooltip="{{tip}}"><i class="fa-solid {{icon}}"></i></a>{{/each}}</span>{{/if}}
              </li>
              {{/each}}
            </ul>
          </section>
        {{/if}}

        {{#if focus.creature}}
        <div data-creature="{{focus.id}}" class="ff-battle-focus">
          <div class="ff-battle-who">
            <img src="{{focus.img}}" alt="">
            <div>
              <h3>{{focus.name}}{{#if focus.player}} <i class="fa-solid fa-user" data-tooltip="{{localize "FASTFIGHTING.Battle.PlayerRuns"}}"></i>{{/if}}</h3>
              <span class="ff-battle-meta">{{focus.side}} · {{focus.status}} · {{focus.hp}}{{#if focus.waiting}} · {{localize "FASTFIGHTING.Battle.NotInFight"}}{{/if}}</span>
              <button type="button" class="ff-btn ff-battle-add" data-action="addLine" data-tooltip="{{localize "FASTFIGHTING.Battle.Net.NodeHint"}}"><i class="fa-solid fa-plus"></i> {{localize "FASTFIGHTING.Battle.Net.AddButton"}}</button>
              {{#if focus.playable}}<label class="ff-battle-automate" data-tooltip="{{localize "FASTFIGHTING.Battle.AutomateHint"}}"><input type="checkbox" data-action="automate" {{checked focus.automated}}> {{localize "FASTFIGHTING.Battle.Automate"}}</label>{{/if}}
            </div>
          </div>

          <section class="ff-battle-teams">
            <p>{{localize "FASTFIGHTING.Battle.Net.Team"}}</p>
            <div>{{#each focus.teams}}<button type="button" class="ff-btn {{#if current}}is-current{{/if}}" data-action="setSide" data-side="{{side}}" {{#if current}}disabled{{/if}} data-tooltip="{{localize "FASTFIGHTING.Battle.Net.TeamHint"}}">{{label}}</button>{{/each}}</div>
            {{#if focus.controlled}}<p class="hint">{{focus.controlled}}</p>{{/if}}
          </section>

          <section>
            <p>{{localize "FASTFIGHTING.Battle.Net.Wants"}}</p>
            {{#if focus.decides}}
              <p class="hint">{{localize "FASTFIGHTING.Battle.Net.PlayerDecides"}}</p>
            {{else}}
              <ul class="ff-battle-list">
                {{#each focus.wants}}
                <li class="{{cls}}"><i class="{{icon}}"></i> <span>{{text}}</span>
                  {{#if steps.length}}<span class="ff-net-steps">{{#each steps}}<a class="ff-net-step" data-action="adjust" data-adjust="{{adjust}}" data-step="{{dir}}" data-tooltip="{{tip}}"><i class="fa-solid {{icon}}"></i></a>{{/each}}</span>{{/if}}
                </li>
                {{else}}
                <li class="hint">{{localize "FASTFIGHTING.Battle.Net.Nothing"}}</li>
                {{/each}}
              </ul>
            {{/if}}
          </section>

          {{#if focus.held.length}}
          <section>
            <p>{{localize "FASTFIGHTING.Battle.Net.HeldList"}}</p>
            <ul class="ff-battle-list">
              {{#each focus.held}}<li class="is-gm"><i class="{{icon}}"></i> <span>{{text}}</span><span class="ff-net-steps"><a class="ff-net-step" data-action="adjust" data-adjust="{{adjust}}" data-step="0" data-tooltip="{{localize "FASTFIGHTING.Battle.Net.HandBack"}}"><i class="fa-solid fa-rotate-left"></i></a></span></li>{{/each}}
            </ul>
          </section>
          {{/if}}

          {{#if focus.setAside.length}}
          <section>
            <p>{{localize "FASTFIGHTING.Battle.Net.SetAsideList"}}</p>
            <ul class="ff-battle-list">
              {{#each focus.setAside}}<li class="is-gm"><i class="{{icon}}"></i> <span>{{text}}</span><span class="ff-net-steps"><a class="ff-net-step" data-action="adjust" data-adjust="{{adjust}}" data-step="0" data-tooltip="{{localize "FASTFIGHTING.Battle.Net.HandBack"}}"><i class="fa-solid fa-rotate-left"></i></a></span></li>{{/each}}
            </ul>
          </section>
          {{/if}}

          <section>
            <p>{{localize "FASTFIGHTING.Battle.Conditions"}}</p>
            <ul class="ff-battle-list">
              {{#each focus.on}}
              <li class="{{cls}}"><i class="{{icon}}"></i> <span>{{text}}</span>
                {{#if steps.length}}<span class="ff-net-steps">{{#each steps}}<a class="ff-net-step" data-action="adjust" data-adjust="{{adjust}}" data-step="{{dir}}" data-tooltip="{{tip}}"><i class="fa-solid {{icon}}"></i></a>{{/each}}</span>{{/if}}
              </li>
              {{else}}
              <li class="hint">{{localize "FASTFIGHTING.Battle.Net.Nothing"}}</li>
              {{/each}}
            </ul>
          </section>

          {{#if focus.wantedBy.length}}
          <section>
            <p>{{localize "FASTFIGHTING.Battle.Net.WantedBy"}}</p>
            <ul class="ff-battle-list">
              {{#each focus.wantedBy}}
              <li class="{{cls}}"><i class="{{icon}}"></i> <span>{{text}}</span>
                {{#if steps.length}}<span class="ff-net-steps">{{#each steps}}<a class="ff-net-step" data-action="adjust" data-adjust="{{adjust}}" data-step="{{dir}}" data-tooltip="{{tip}}"><i class="fa-solid {{icon}}"></i></a>{{/each}}</span>{{/if}}
              </li>
              {{/each}}
            </ul>
          </section>
          {{/if}}

        </div>
        {{/if}}
      </aside>
    </div>
  {{/if}}
</section>
